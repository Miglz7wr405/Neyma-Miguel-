{
  "name": "our-sacred-place",
  "private": true,
  "version": "2.0.0",
  "description": "Private WhatsApp-style PWA for two people. No server, no setup.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
